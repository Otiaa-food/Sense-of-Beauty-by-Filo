# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local wird NIEMALS committet (steht in .gitignore).

# --- Supabase (Phase 1/2) ---
# Projekt-URL und öffentlicher (publishable) Schlüssel dürfen im Browser landen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GEHEIM: nur auf dem Server. Niemals mit NEXT_PUBLIC_ beginnen lassen.
SUPABASE_SECRET_KEY=

# --- E-Mail über Resend (Phase 6) ---
RESEND_API_KEY=

# --- Zahlungen über Stripe (Phase 7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Google (später, Phase 8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron-Schutz für Erinnerungs-Mails (Phase 6) ---
CRON_SECRET=
